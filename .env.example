# ---------- Database ----------
# Local dev (SQLite, zero setup — prisma/schema.prisma mein provider "sqlite"):
DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL — schema.prisma mein provider "postgresql" kar dein):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sya?sslmode=require"

# ---------- Secrets ----------
# Dono alag hone chahiye. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
VIDEO_TOKEN_SECRET="change-me-to-another-long-random-string"

# ---------- WhatsApp ----------
# Country code ke saath, bina + ya space. Sohail ka asli number yahan daalein.
NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

# ---------- Payment gateway (Razorpay) ----------
# Khaali chhodne par app "demo mode" mein chalta hai: poora flow chalta hai,
# bas asli paisa nahi katta. Keys daalte hi real checkout khul jaata hai.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay dashboard > Webhooks mein jo secret set karein, wahi yahan.
# Webhook URL: https://<domain>/api/payment/webhook   (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=""
