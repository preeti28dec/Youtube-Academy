# docker compose ke liye. Copy karke .env.docker banayein.
# Yeh file local .env (sqlite wali) se alag hai aur usse takraati nahi.

POSTGRES_PASSWORD="ek-lamba-random-password"

AUTH_SECRET="change-me"
VIDEO_TOKEN_SECRET="change-me-alag"

NEXT_PUBLIC_WHATSAPP_NUMBER="919999999999"

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Pehli baar demo data chahiye to true karein (production mein hamesha false)
SEED_ON_START="false"

# Video origin agar apne hi network par ho (LAN NAS, ya Docker compose ka
# MinIO/nginx) to "1" karein. Default off — public hosting par private
# network kholna theek nahi (SSRF).
VIDEO_ALLOW_PRIVATE_HOSTS=""
